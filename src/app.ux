<script>
import interconnfile from "./utils/interconnfile"
import interconn from "./utils/handshake"
import router from '@system.router'
import storage from './utils/storage.js'
import file from '@system.file'
globalThis.conn = new interconn();
globalThis.conn.setHandshakeListener(() => {
  router.push({uri: 'pages/push'})
})
globalThis.connfile = globalThis.conn.register(interconnfile);
export default {
  onInit() {
    // 确保密码存储目录存在：internal://files/books/storage-api/
    // 目录不存在时 file.writeText 会失败，导致密码写入不成功
    file.mkdir({
      uri: 'internal://files/books/',
      complete: function () {
        // storage-api：utils/storage.js 用（密码 EBOOK_PASSWORD 等）
        file.mkdir({
          uri: 'internal://files/books/storage-api/'
        });
        // stroage-api：common/storage.js 用（拼写如此，不能改，
        // 改了就读不到已存在的数据了）
        file.mkdir({
          uri: 'internal://files/books/stroage-api/'
        });
      }
    });
  },
  onShow() {
    // 检查是否已设置密码，未设置则跳转到设置密码页面
    storage.get({
      key: 'EBOOK_PASSWORD',
      success: (password) => {
        if (!password) {
          router.replace({
            uri: '/pages/SetPassword'
          });
        }
      }
    });
  }
}
</script>